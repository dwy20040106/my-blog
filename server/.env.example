# ======================= 服务配置 =======================
# Node 接口监听端口；Nginx 反代 /api → 127.0.0.1:3001
PORT=3001
HOST=0.0.0.0

# ===================== MySQL 配置 =====================
# 宝塔面板 → 数据库 → 添加数据库 之后，把这里改成你实际的信息
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=my_blog
DB_USER=my_blog
DB_PASSWORD=CHANGE_ME
DB_CONNECTION_LIMIT=10
# 时区：默认跟随服务器本地时区，一般不用改
DB_TIMEZONE=local

# ==================== 跨域 / 安全 ====================
# 允许跨域的前端地址，逗号分隔。
# 留空 = 允许所有来源（同域部署时用不到 CORS，可留空）
# 前后端分属不同域名时填写，例如：https://www.your-domain.com
CORS_ORIGIN=

# 管理员令牌：可选。
# 配置后，带 X-Admin-Token 的请求可以删除任意评论（前端需同时配 VITE_ADMIN_TOKEN）。
# 留空时：评论只能删除本 IP 发表的；备忘录仍保持公开软删除。
ADMIN_TOKEN=

# ==================== 写入限流 ====================
# 每个 IP 在 WINDOW 毫秒内最多写 MAX 次（发评论 / 发备忘 / 点赞 / 删除）
WRITE_RATE_WINDOW_MS=60000
WRITE_RATE_MAX=20

# 每个 IP 每天最多点赞次数
LIKE_DAILY_LIMIT=10

# ==================== 静态站点托管 ====================
# false：静态文件交给 Nginx（推荐，性能更好）
# true ：由 Node 同时托管 docs/.vitepress/dist（只需一个 Node 项目）
SERVE_STATIC=false
# 静态目录，相对 server/ 目录解析
STATIC_DIR=../docs/.vitepress/dist
